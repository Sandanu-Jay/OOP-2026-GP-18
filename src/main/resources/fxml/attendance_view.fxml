<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.AttendanceManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Course Attendance &amp; 80% Eligibility" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <Label text="15 Theory + 15 Practical Sessions (30 Total). Includes approved medicals." style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />
        
        <Label fx:id="lblCourseSelector" text="Filter Course:" styleClass="form-label" />
        <ComboBox fx:id="cmbCourses" prefWidth="250" />
        
        <Button fx:id="btnMarkAttendance" text="+ Record Attendance" onAction="#handleMarkAttendance" styleClass="btn-primary" />
        <Button fx:id="btnRefresh" text="↻" onAction="#handleRefresh" styleClass="btn-secondary" />
    </HBox>

    <!-- Attendance Summary Table -->
    <TableView fx:id="tblAttendance" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRegNo" text="Reg No" prefWidth="105" />
            <TableColumn fx:id="colStudentName" text="Student Name" prefWidth="160" />
            <TableColumn fx:id="colCourseCode" text="Course" prefWidth="80" />
            <TableColumn fx:id="colTheoryAttended" text="Theory (/15)" prefWidth="85" />
            <TableColumn fx:id="colPracticalAttended" text="Practical (/15)" prefWidth="90" />
            <TableColumn fx:id="colTotalAttended" text="Total Attended" prefWidth="95" />
            <TableColumn fx:id="colRawPercentage" text="Raw %" prefWidth="75" />
            <TableColumn fx:id="colApprovedMedicals" text="Medicals" prefWidth="75" />
            <TableColumn fx:id="colEffectivePercentage" text="Effective %" prefWidth="85" />
            <TableColumn fx:id="colEligibility" text="Attendance Status (≥80%)" prefWidth="175" />
            <TableColumn fx:id="colScenario" text="Category" prefWidth="165" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
