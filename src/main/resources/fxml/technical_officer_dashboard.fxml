<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.faculty.management.controller.TechnicalOfficerDashboardController"
            prefWidth="1180" prefHeight="720">

    <!-- Modern Dark Sidebar (Left) -->
    <left>
        <VBox styleClass="sidebar">
            <VBox spacing="4" style="-fx-padding: 0 0 16 8;">
                <Label text="🎓 FacultyTO" styleClass="sidebar-brand-title" />
                <Label text="Technical Officer Portal" styleClass="sidebar-brand-subtitle" />
            </VBox>

            <Separator style="-fx-opacity: 0.2; -fx-padding: 0 0 10 0;" />

            <!-- Nav Links -->
            <Label text="LAB &amp; SESSIONS" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavDashboard" text="📊 Dashboard Overview" onAction="#showDashboardOverview" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavAttendance" text="🕒 Student Attendance" onAction="#showAttendance" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavMedical" text="🏥 Medical Certificates" onAction="#showMedical" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavTimetable" text="📅 Department Timetable" onAction="#showTimetable" styleClass="sidebar-button" maxWidth="Infinity" />

            <Label text="DIRECTORY &amp; PORTAL" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavStudents" text="🎓 Undergraduates" onAction="#showStudents" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavNotices" text="📢 Announcements" onAction="#showNotices" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavProfile" text="👤 Officer Profile" onAction="#showProfile" styleClass="sidebar-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button text="🚪 Logout" onAction="#handleLogout" styleClass="sidebar-logout-btn" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <VBox>
            <!-- Top Header Bar -->
            <HBox styleClass="top-header">
                <Label fx:id="lblPageTitle" text="Technical Officer Dashboard" styleClass="header-title" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblOfficerName" text="Technical Officer" styleClass="user-header-name" />
                        <Label text="Department Lab Technical Staff" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                    </VBox>
                    <Label text="OFFICER" styleClass="user-badge-role" />
                </HBox>
            </HBox>

            <!-- Dynamic Body Area -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Overview View (Default) -->
                <VBox fx:id="overviewView" spacing="24" styleClass="content-pane">
                    
                    <!-- Welcome Card -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="card" style="-fx-background-color: linear-gradient(to right, #2563EB, #1D4ED8); -fx-padding: 24px;">
                        <VBox spacing="6">
                            <Label text="Technical &amp; Laboratory Operations Portal" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Label text="Manage theory and lab practical attendance sessions, review student medicals, and inspect department schedules." style="-fx-text-fill: #DBEAFE; -fx-font-size: 13px;" />
                        </VBox>
                    </HBox>

                    <!-- Metric Cards Grid -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <!-- Total Students Enrolled -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Faculty Undergraduates" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🎓" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblTotalStudentsCount" text="20" styleClass="metric-value" />
                            <Label text="Students under laboratory supervision" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Pending Medicals -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Pending Medical Certificates" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🏥" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblPendingMedicalsCount" text="1" styleClass="metric-value" style="-fx-text-fill: #D97706;" />
                            <Label text="Submissions awaiting verification and approval" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>
                    </GridPane>

                    <!-- Quick Shortcuts Card -->
                    <VBox spacing="12" styleClass="card">
                        <Label text="Quick Operational Tasks" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                        <HBox spacing="12">
                            <Button text="🕒 Log Session Attendance" onAction="#showAttendance" styleClass="btn-primary" />
                            <Button text="🏥 Process Medical Certificates" onAction="#showMedical" styleClass="btn-primary" />
                            <Button text="📅 Department Lab Timetable" onAction="#showTimetable" styleClass="btn-secondary" />
                            <Button text="📢 View Faculty Notices" onAction="#showNotices" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                </VBox>
            </StackPane>
        </VBox>
    </center>

</BorderPane>
