<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.faculty.management.controller.AdminDashboardController"
            prefWidth="1180" prefHeight="720">

    <!-- Modern Dark Sidebar (Left) -->
    <left>
        <VBox styleClass="sidebar">
            <!-- Brand -->
            <VBox spacing="4" style="-fx-padding: 0 0 16 8;">
                <Label text="🎓 FacultyAdmin" styleClass="sidebar-brand-title" />
                <Label text="University Faculty System" styleClass="sidebar-brand-subtitle" />
            </VBox>

            <Separator style="-fx-opacity: 0.2; -fx-padding: 0 0 10 0;" />

            <!-- Nav Links -->
            <Label text="MAIN NAVIGATION" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavDashboard" text="📊 Dashboard Overview" onAction="#showDashboardOverview" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavStudents" text="🎓 Undergraduates" onAction="#showStudents" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavLecturers" text="👨‍🏫 Lecturers" onAction="#showLecturers" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavOfficers" text="🛠 Technical Officers" onAction="#showOfficers" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavCourses" text="📚 Courses &amp; Materials" onAction="#showCourses" styleClass="sidebar-button" maxWidth="Infinity" />

            <Label text="MANAGEMENT" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavNotices" text="📢 Announcements" onAction="#showNotices" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavTimetable" text="📅 Master Timetable" onAction="#showTimetable" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavProfile" text="👤 Admin Profile" onAction="#showProfile" styleClass="sidebar-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button text="🚪 Logout" onAction="#handleLogout" styleClass="sidebar-logout-btn" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <VBox>
            <!-- Top Header Bar -->
            <HBox styleClass="top-header">
                <Label fx:id="lblPageTitle" text="Dashboard Overview" styleClass="header-title" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblAdminName" text="Administrator" styleClass="user-header-name" />
                        <Label text="System Administrator" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                    </VBox>
                    <Label text="ADMIN" styleClass="user-badge-role" />
                </HBox>
            </HBox>

            <!-- Dynamic Body Area -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Overview View (Default) -->
                <VBox fx:id="overviewView" spacing="24" styleClass="content-pane">
                    
                    <!-- Welcome Card -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="card" style="-fx-background-color: linear-gradient(to right, #2563EB, #1D4ED8); -fx-padding: 24px;">
                        <VBox spacing="6">
                            <Label text="Welcome to Faculty Administration Hub" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Label text="Manage undergraduates, academic staff, courses, timetables, and notices." style="-fx-text-fill: #DBEAFE; -fx-font-size: 13px;" />
                        </VBox>
                    </HBox>

                    <!-- Metric Cards Grid -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                        </columnConstraints>

                        <!-- Total Students -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Undergraduates" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🎓" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblTotalStudents" text="20" styleClass="metric-value" />
                            <Label text="Registered Students" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Total Lecturers -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Academic Staff" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="👨‍🏫" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblTotalLecturers" text="5" styleClass="metric-value" />
                            <Label text="Lecturers &amp; Professors" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Total Officers -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="2">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Technical Officers" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🛠" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblTotalOfficers" text="4" styleClass="metric-value" />
                            <Label text="Laboratory Staff" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Total Courses -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="3">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Offered Courses" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="📚" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblTotalCourses" text="5" styleClass="metric-value" />
                            <Label text="Active Modules" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>
                    </GridPane>

                    <!-- Quick Shortcuts Card -->
                    <VBox spacing="12" styleClass="card">
                        <Label text="Quick Administrative Actions" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                        <HBox spacing="12">
                            <Button text="➕ Register Undergraduate" onAction="#showStudents" styleClass="btn-primary" />
                            <Button text="👨‍🏫 Add Academic Staff" onAction="#showLecturers" styleClass="btn-primary" />
                            <Button text="📚 Create Course Module" onAction="#showCourses" styleClass="btn-secondary" />
                            <Button text="📢 Publish Faculty Notice" onAction="#showNotices" styleClass="btn-secondary" />
                            <Button text="📅 Edit Master Timetable" onAction="#showTimetable" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                </VBox>
            </StackPane>
        </VBox>
    </center>

</BorderPane>
