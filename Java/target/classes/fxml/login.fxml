<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.faculty.management.controller.LoginController"
           styleClass="login-root" prefWidth="1050" prefHeight="680">

    <VBox alignment="CENTER" maxWidth="440" maxHeight="560" styleClass="login-card" spacing="16">
        
        <!-- Logo / Icon Placeholder -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="🎓" style="-fx-font-size: 38px;" />
            <Label text="Faculty Management System" styleClass="login-title" />
            <Label text="University Academic &amp; Administration Portal" styleClass="login-subtitle" />
        </VBox>

        <Separator style="-fx-opacity: 0.6;" />

        <!-- Form Fields -->
        <VBox spacing="12">
            <VBox spacing="4">
                <Label text="Username" styleClass="form-label" />
                <TextField fx:id="txtUsername" promptText="Enter your username" styleClass="login-input-field" />
            </VBox>

            <VBox spacing="4">
                <Label text="Password" styleClass="form-label" />
                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="txtPassword" promptText="Enter your password" styleClass="login-input-field" />
                    <TextField fx:id="txtPasswordVisible" promptText="Enter your password" styleClass="login-input-field" />
                </StackPane>
                <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 4 0 0 0;">
                    <CheckBox fx:id="chkShowPassword" text="Show Password" style="-fx-text-fill: #64748B; -fx-font-size: 11px;" />
                </HBox>
            </VBox>
        </VBox>

        <!-- Error Message -->
        <Label fx:id="lblError" text="" styleClass="login-error-label" wrapText="true" alignment="CENTER" textAlignment="CENTER" />

        <!-- Sign In Button -->
        <Button fx:id="btnLogin" text="Sign In to Faculty Portal" onAction="#handleLogin"
                styleClass="login-btn" maxWidth="Infinity" />


    </VBox>

</StackPane>
