<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.OfficerManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Technical Officers &amp; Lab Staff" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Region HBox.hgrow="ALWAYS" />
        
        <TextField fx:id="txtSearch" promptText="🔍 Search by Name, Department..." prefWidth="260" />
        <Button fx:id="btnAdd" text="+ Add Officer" onAction="#handleAddOfficer" styleClass="btn-primary" />
        <Button fx:id="btnEdit" text="Edit" onAction="#handleEditOfficer" styleClass="btn-secondary" />
        <Button fx:id="btnDelete" text="Delete" onAction="#handleDeleteOfficer" styleClass="btn-danger" />
        <Button fx:id="btnRefresh" text="↻" onAction="#loadOfficers" styleClass="btn-secondary" />
    </HBox>

    <!-- Officers Table -->
    <TableView fx:id="tblOfficers" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFullName" text="Full Name" prefWidth="240" />
            <TableColumn fx:id="colDepartment" text="Assigned Department" prefWidth="260" />
            <TableColumn fx:id="colEmail" text="Email Address" prefWidth="240" />
            <TableColumn fx:id="colPhone" text="Contact No" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
