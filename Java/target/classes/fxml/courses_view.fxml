<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.CourseManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Course Catalog &amp; Learning Materials" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox fx:id="adminControls" spacing="8">
            <Button fx:id="btnAddCourse" text="+ Add Course" onAction="#handleAddCourse" styleClass="btn-primary" />
            <Button fx:id="btnEditCourse" text="Edit" onAction="#handleEditCourse" styleClass="btn-secondary" />
            <Button fx:id="btnDeleteCourse" text="Delete" onAction="#handleDeleteCourse" styleClass="btn-danger" />
        </HBox>
        <HBox fx:id="studentControls" spacing="8">
            <Button fx:id="btnRegisterCourse" text="📝 Register for Course" onAction="#handleRegisterCourse" styleClass="btn-primary" />
            <Button fx:id="btnDropCourse" text="Drop Course" onAction="#handleDropCourse" styleClass="btn-danger" />
        </HBox>
        <Button text="↻" onAction="#loadCourses" styleClass="btn-secondary" />
    </HBox>

    <!-- Split between Courses Table (Top) and Course Materials (Bottom) -->
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- Top Half: Courses Table -->
        <VBox spacing="8" styleClass="card">
            <Label text="Courses" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <TableView fx:id="tblCourses" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCourseCode" text="Code" prefWidth="100" />
                    <TableColumn fx:id="colCourseName" text="Course Name" prefWidth="250" />
                    <TableColumn fx:id="colCredit" text="Credits" prefWidth="70" />
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="220" />
                    <TableColumn fx:id="colSemester" text="Semester" prefWidth="80" />
                    <TableColumn fx:id="colLecturer" text="Lecturer-in-Charge" prefWidth="200" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Bottom Half: Selected Course Materials -->
        <VBox spacing="8" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Course Materials &amp; Resources" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                    <Label fx:id="lblSelectedCourse" text="Select a course to view materials" style="-fx-font-size: 12px; -fx-text-fill: #2563EB; -fx-font-weight: 600;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox fx:id="materialControls" spacing="8">
                    <Button fx:id="btnAddMaterial" text="+ Upload Material" onAction="#handleAddMaterial" styleClass="btn-primary" />
                    <Button fx:id="btnDeleteMaterial" text="Delete Resource" onAction="#handleDeleteMaterial" styleClass="btn-danger" />
                </HBox>
            </HBox>

            <TableView fx:id="tblMaterials" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMaterialTitle" text="Title" prefWidth="250" />
                    <TableColumn fx:id="colMaterialDesc" text="Description" prefWidth="350" />
                    <TableColumn fx:id="colMaterialType" text="Type" prefWidth="150" />
                    <TableColumn fx:id="colMaterialDate" text="Uploaded Date" prefWidth="160" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>

</VBox>
