<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.NoticeManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Faculty Notices &amp; Announcements" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox fx:id="adminControls" spacing="8">
            <Button fx:id="btnAddNotice" text="+ Publish Notice" onAction="#handleAddNotice" styleClass="btn-primary" />
            <Button fx:id="btnEditNotice" text="Edit" onAction="#handleEditNotice" styleClass="btn-secondary" />
            <Button fx:id="btnDeleteNotice" text="Delete" onAction="#handleDeleteNotice" styleClass="btn-danger" />
        </HBox>
        <Button fx:id="btnRefresh" text="↻" onAction="#loadNotices" styleClass="btn-secondary" />
    </HBox>

    <!-- Split Pane between Notice List and Notice Details Preview -->
    <SplitPane orientation="HORIZONTAL" dividerPositions="0.5" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- Left: Notices Table -->
        <VBox spacing="8" styleClass="card">
            <Label text="All Announcements" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <TableView fx:id="tblNotices" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPinned" text="📌" prefWidth="40" />
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="240" />
                    <TableColumn fx:id="colTarget" text="Target" prefWidth="90" />
                    <TableColumn fx:id="colAuthor" text="Posted By" prefWidth="140" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="130" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Selected Notice Full Content Preview -->
        <VBox spacing="14" styleClass="card">
            <VBox spacing="6">
                <Label fx:id="lblNoticeTitle" text="Select a notice to view contents" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" wrapText="true" />
                <Label fx:id="lblNoticeMeta" text="" style="-fx-font-size: 12px; -fx-text-fill: #64748B;" />
            </VBox>
            <Separator />
            <TextArea fx:id="txtNoticeContent" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px; -fx-text-fill: #1E293B;" />
        </VBox>
    </SplitPane>

</VBox>
