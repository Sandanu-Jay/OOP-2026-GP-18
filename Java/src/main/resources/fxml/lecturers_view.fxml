<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.LecturerManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Faculty Lecturers &amp; Academic Staff" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Region HBox.hgrow="ALWAYS" />
        
        <TextField fx:id="txtSearch" promptText="🔍 Search by Name, Department, Title..." prefWidth="260" />
        <Button fx:id="btnAdd" text="+ Add Lecturer" onAction="#handleAddLecturer" styleClass="btn-primary" />
        <Button fx:id="btnEdit" text="Edit" onAction="#handleEditLecturer" styleClass="btn-secondary" />
        <Button fx:id="btnDelete" text="Delete" onAction="#handleDeleteLecturer" styleClass="btn-danger" />
        <Button fx:id="btnRefresh" text="↻" onAction="#loadLecturers" styleClass="btn-secondary" />
    </HBox>

    <!-- Lecturers Table -->
    <TableView fx:id="tblLecturers" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFullName" text="Full Name" prefWidth="220" />
            <TableColumn fx:id="colDesignation" text="Designation" prefWidth="180" />
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="220" />
            <TableColumn fx:id="colEmail" text="Email Address" prefWidth="200" />
            <TableColumn fx:id="colPhone" text="Contact No" prefWidth="130" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
