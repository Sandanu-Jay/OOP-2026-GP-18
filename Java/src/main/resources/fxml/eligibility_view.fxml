<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.EligibilityViewController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Undergraduate Final-Exam Eligibility" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <Label text="Criteria: Continuous Assessment (CA) ≥ 40% AND Attendance ≥ 80% (including approved medicals)" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />
        
        <Label fx:id="lblFilter" text="Course:" styleClass="form-label" />
        <ComboBox fx:id="cmbCourses" prefWidth="250" />
        <Button text="↻" onAction="#handleRefresh" styleClass="btn-secondary" />
    </HBox>

    <!-- Eligibility Table -->
    <TableView fx:id="tblEligibility" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRegNo" text="Reg No" prefWidth="110" />
            <TableColumn fx:id="colStudentName" text="Student Name" prefWidth="200" />
            <TableColumn fx:id="colCourseCode" text="Course" prefWidth="90" />
            <TableColumn fx:id="colCaMark" text="CA Mark" prefWidth="85" />
            <TableColumn fx:id="colCaStatus" text="CA Eligibility (≥40%)" prefWidth="160" />
            <TableColumn fx:id="colAttendance" text="Attendance %" prefWidth="105" />
            <TableColumn fx:id="colAttendanceStatus" text="Attendance Status (≥80%)" prefWidth="175" />
            <TableColumn fx:id="colFinalStatus" text="Final Exam Eligibility" prefWidth="170" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
