<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.CourseManagementController">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Course Management"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Region HBox.hgrow="ALWAYS" />

        <!-- Admin-only course management -->
        <HBox fx:id="adminControls" spacing="8">
            <Button text="+ Add Course" onAction="#handleAddCourse" styleClass="btn-primary" />
            <Button text="Edit" onAction="#handleEditCourse" styleClass="btn-secondary" />
            <Button text="Delete" onAction="#handleDeleteCourse" styleClass="btn-danger" />
        </HBox>

        <!-- Student-only registration controls -->
        <HBox fx:id="studentControls" spacing="8">
            <Button text="Register for Course" onAction="#handleRegisterCourse" styleClass="btn-primary" />
            <Button text="Drop Course" onAction="#handleDropCourse" styleClass="btn-danger" />
        </HBox>

        <Button text="↻" onAction="#loadCourses" styleClass="btn-secondary" />
    </HBox>

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="Courses"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <TableView fx:id="tblCourses" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCourseCode" text="Code" prefWidth="100" />
                <TableColumn fx:id="colCourseName" text="Course Name" prefWidth="250" />
                <TableColumn fx:id="colCredit" text="Credits" prefWidth="70" />
                <TableColumn fx:id="colDepartment" text="Department" prefWidth="220" />
                <TableColumn fx:id="colLevel" text="Level" prefWidth="65" />
                <TableColumn fx:id="colSemester" text="Semester" prefWidth="80" />
                <TableColumn fx:id="colLecturer" text="Lecturer-in-Charge" prefWidth="200" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Visible only to lecturers and students; never shown to admins -->
    <VBox fx:id="materialsSection" spacing="8" styleClass="card" prefHeight="230">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Course Learning Materials"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                <Label fx:id="lblSelectedCourse" text="Select a course to view its learning materials."
                       style="-fx-text-fill: #64748B;" />
            </VBox>
            <HBox fx:id="lecturerMaterialControls" spacing="8">
                <Button fx:id="btnUploadMaterial" text="＋ Upload File"
                        onAction="#handleUploadMaterial" styleClass="btn-primary" />
                <Button fx:id="btnDeleteMaterial" text="Delete"
                        onAction="#handleDeleteMaterial" styleClass="btn-danger" />
            </HBox>
            <Button fx:id="btnOpenMaterial" text="Open / Download"
                    onAction="#handleOpenMaterial" styleClass="btn-primary" />
        </HBox>

        <TableView fx:id="tblMaterials" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaterialTitle" text="Material" prefWidth="260" />
                <TableColumn fx:id="colMaterialFile" text="File Name" prefWidth="260" />
                <TableColumn fx:id="colMaterialDate" text="Uploaded Date" prefWidth="180" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
