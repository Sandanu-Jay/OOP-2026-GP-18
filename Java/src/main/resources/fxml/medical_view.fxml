<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="content-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.faculty.management.controller.MedicalManagementController">

    <!-- Top Action Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Undergraduate Medical Certificates" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
            <Label text="Approve or reject medical certificates for missed theory and practical sessions" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        
        <HBox fx:id="studentControls" spacing="8">
            <Button fx:id="btnStudentSubmitMedical" text="🏥 Submit Medical" onAction="#handleStudentSubmitMedical" styleClass="btn-primary" />
        </HBox>
        <HBox fx:id="officerControls" spacing="8">
            <Button fx:id="btnAddMedical" text="+ Add Record" onAction="#handleAddMedical" styleClass="btn-primary" />
            <Button fx:id="btnApprove" text="✓ Approve" onAction="#handleApprove" styleClass="btn-success" />
            <Button fx:id="btnReject" text="✕ Reject" onAction="#handleReject" styleClass="btn-danger" />
            <Button fx:id="btnDelete" text="Delete" onAction="#handleDeleteMedical" styleClass="btn-secondary" />
        </HBox>
        <Button fx:id="btnRefresh" text="↻" onAction="#loadMedicals" styleClass="btn-secondary" />
    </HBox>

    <!-- Medical Records Table -->
    <TableView fx:id="tblMedicals" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRegNo" text="Reg No" prefWidth="110" />
            <TableColumn fx:id="colStudentName" text="Student Name" prefWidth="150" />
            <TableColumn fx:id="colCourseCode" text="Course" prefWidth="85" />
            <TableColumn fx:id="colSessionType" text="Type" prefWidth="85" />
            <TableColumn fx:id="colSessionNum" text="Session #" prefWidth="75" />
            <TableColumn fx:id="colMedicalDate" text="Absence Date" prefWidth="105" />
            <TableColumn fx:id="colReason" text="Medical Reason" prefWidth="170" />
            <TableColumn fx:id="colDocumentInfo" text="Certificate Reference" prefWidth="180" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="95" />
            <TableColumn fx:id="colComments" text="Remarks / Verification" prefWidth="160" />
            <TableColumn fx:id="colSubmittedDate" text="Submission Time" prefWidth="140" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
