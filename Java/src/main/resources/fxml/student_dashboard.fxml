<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.faculty.management.controller.StudentDashboardController"
            prefWidth="1180" prefHeight="720">

    <!-- Modern Dark Sidebar (Left) -->
    <left>
        <VBox styleClass="sidebar">
            <VBox spacing="4" style="-fx-padding: 0 0 16 8;">
                <Label text="🎓 StudentPortal" styleClass="sidebar-brand-title" />
                <Label text="Undergraduate Self-Service" styleClass="sidebar-brand-subtitle" />
            </VBox>

            <Separator style="-fx-opacity: 0.2; -fx-padding: 0 0 10 0;" />

            <!-- Nav Links -->
            <Label text="ACADEMICS &amp; RESULTS" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavDashboard" text="📊 Portal Overview" onAction="#showDashboardOverview" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavGpa" text="⭐ My GPA &amp; Grades" onAction="#showGpa" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavMarks" text="📝 Marks &amp; CA Status" onAction="#showMarks" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavCourses" text="📚 Enrolled Courses" onAction="#showCourses" styleClass="sidebar-button" maxWidth="Infinity" />

            <Label text="ATTENDANCE &amp; SCHEDULE" styleClass="sidebar-category-header" />
            <Button fx:id="btnNavAttendance" text="🕒 My Attendance" onAction="#showAttendance" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavMedical" text="🏥 Medical Submissions" onAction="#showMedical" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavTimetable" text="📅 Class Timetable" onAction="#showTimetable" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavNotices" text="📢 Announcements" onAction="#showNotices" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button fx:id="btnNavProfile" text="👤 My Profile" onAction="#showProfile" styleClass="sidebar-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button text="🚪 Logout" onAction="#handleLogout" styleClass="sidebar-logout-btn" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Center Content Area -->
    <center>
        <VBox>
            <!-- Top Header Bar -->
            <HBox styleClass="top-header">
                <Label fx:id="lblPageTitle" text="Undergraduate Portal Overview" styleClass="header-title" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblStudentName" text="Undergraduate Student" styleClass="user-header-name" />
                        <Label fx:id="lblRegNoHeader" text="TG/2022/1001" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                    </VBox>
                    <Label text="STUDENT" styleClass="user-badge-role" />
                </HBox>
            </HBox>

            <!-- Dynamic Body Area -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
                <!-- Overview View (Default) -->
                <VBox fx:id="overviewView" spacing="24" styleClass="content-pane">
                    
                    <!-- Welcome Card -->
                    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="card" style="-fx-background-color: linear-gradient(to right, #2563EB, #1D4ED8); -fx-padding: 24px;">
                        <VBox spacing="6">
                            <Label text="Welcome to your Student Academic Portal" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Label text="Access your grades (UGC Circular 12-2024), attendance tracking, approved medical certificates, and timetable." style="-fx-text-fill: #DBEAFE; -fx-font-size: 13px;" />
                        </VBox>
                    </HBox>

                    <!-- Metric Cards Grid -->
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                            <ColumnConstraints percentWidth="25" />
                        </columnConstraints>

                        <!-- CGPA -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Cumulative GPA" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="⭐" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblCgpaValue" text="0.00" styleClass="metric-value" style="-fx-text-fill: #2563EB;" />
                            <Label text="Calculated per UGC 12-2024" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Overall Attendance % -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="1">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Attendance Rate" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🕒" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblAttendancePercentage" text="90%" styleClass="metric-value" style="-fx-text-fill: #059669;" />
                            <Label text="30 Theory &amp; Practical sessions" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Enrolled Courses -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="2">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Enrolled Modules" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="📚" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblEnrolledCoursesCount" text="2" styleClass="metric-value" />
                            <Label text="Current semester courses" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>

                        <!-- Final Exam Eligibility -->
                        <VBox styleClass="card" spacing="8" GridPane.columnIndex="3">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Exam Eligibility" styleClass="metric-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="📋" style="-fx-font-size: 20px;" />
                            </HBox>
                            <Label fx:id="lblExamEligibilityStatus" text="ELIGIBLE" styleClass="metric-value" style="-fx-text-fill: #059669;" />
                            <Label text="Requires CA ≥ 40% &amp; Att ≥ 80%" style="-fx-font-size: 11px; -fx-text-fill: #64748B;" />
                        </VBox>
                    </GridPane>

                    <!-- Quick Shortcuts Card -->
                    <VBox spacing="12" styleClass="card">
                        <Label text="My Quick Actions" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                        <HBox spacing="12">
                            <Button text="⭐ View Detailed GPA Breakdown" onAction="#showGpa" styleClass="btn-primary" />
                            <Button text="🕒 View Session Attendance" onAction="#showAttendance" styleClass="btn-secondary" />
                            <Button text="📚 Access Course Materials" onAction="#showCourses" styleClass="btn-secondary" />
                            <Button text="📅 Check Class Timetable" onAction="#showTimetable" styleClass="btn-secondary" />
                            <Button text="👤 Update Contact Details" onAction="#showProfile" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                </VBox>
            </StackPane>
        </VBox>
    </center>

</BorderPane>
